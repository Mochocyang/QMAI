# ============================================================================
# 青幕AI写作（QMAI）服务端环境变量清单
# ============================================================================
#
# 本文件只列「需要配置哪些变量、各自做什么」，**不包含任何真实值**。
# 真实值请通过以下两种方式注入，绝对不要写进仓库或 wrangler.toml：
#
#   普通配置（可公开，如端口、开关）：
#     wrangler.toml 的 [vars] 段
#
#   密钥类（必须保密）：
#     npx wrangler secret put <变量名>
#
# ---------------------------------------------------------------------------
# 部署顺序（三套服务互相独立，可按需只部署其中一部分）
# ---------------------------------------------------------------------------
#   1. analytics-worker    匿名使用统计 + 公告 + 后台
#   2. account-worker      账号注册/登录、云同步配置、内置模型的网关卡
#   3. cloudflare/plugin-cdn  插件分发
#   4. cloudflare/legal-site  条款页（也可由 account-worker 内嵌提供）
#
# 部署前先建 D1 数据库：
#   npx wrangler d1 create qmai-account-db
#   npx wrangler d1 create qmai-analytics-db
# 把返回的 database_id 填进对应 wrangler.toml。
# ============================================================================


# ============================================================================
# account-worker —— 账号服务
# ============================================================================
# 部署目录：account-worker/
# 路由：account.qmai.pro（API）、qmai.pro/legal（条款页）、qmai.pro/oauth/baidu/*

# 【必填·普通配置】运行环境。只有 "development" 才会开启下面 ALLOW_DEV_CODE 相关的便利行为。
# 生产环境必须写 production。
ENVIRONMENT=production

# 【必填·普通配置】允许跨域访问 API 的站点白名单，逗号分隔。
# 桌面客户端（Tauri）的来源不是普通 https 站点，需要把 tauri 的自定义协议算进去。
# 示例：tauri://localhost,https://tauri.localhost,https://qmai.pro
APP_ALLOWED_ORIGINS=

# 【必填·普通配置】邮件发送方式。目前支持 resend。
EMAIL_PROVIDER=resend

# 【必填·普通配置】验证码邮件的发件人。
# 注意：域名必须已在邮件服务商那边完成验证（SPF/DKIM），否则会被判垃圾邮件。
AUTH_EMAIL_FROM=

# 【必填·密钥】Resend 的 API Key，用于发送邮箱验证码。
# 生成位置：Resend 控制台 → API Keys
RESEND_API_KEY=

# 【必填·密钥】验证码哈希的 pepper。
# 数据库里只存 SHA-256(pepper + email + 用途 + 验证码)，即使库被拖走也反推不出验证码。
# 要求：足够长的随机串，且**一旦设定不要随意更换**——换了会导致所有在途验证码失效。
AUTH_CODE_PEPPER=

# 【必填·密钥】登录令牌（JWT）的签名密钥。
# 泄露意味着别人可以伪造任意用户的登录态。
AUTH_JWT_SECRET=

# 【必填·密钥】网卡片的 Ed25519 私钥（PKCS#8，base64）。
# 网卡片是登录后下发给客户端的凭证，用于访问内置模型的中转站。
# 私钥只在这里；对应的公钥要配到中转站侧做验签。
# 生成方式：自行用 openssl 或 crypto 生成一对 Ed25519 密钥，私钥转成 PKCS#8 base64。
NETCARD_PRIVATE_KEY=

# 【必填·密钥】管理接口密钥（/admin/*）。
# 未配置时所有 /admin/* 返回 503（失败关闭）——宁可没有管理功能，也不开一个没锁的门。
ADMIN_KEY=

# 【可选·普通配置】密码哈希迭代次数。不填默认 210000。
# 调高更安全但更吃 CPU；调低会让登录变快但削弱抗暴力破解能力。
PASSWORD_ITERATIONS=210000

# 【可选·普通配置】同一设备最多可注册几个账号。不填用代码内默认值。
MAX_ACCOUNTS_PER_DEVICE=

# 【开发专用·默认关闭】是否允许把验证码直接返回给客户端（跳过收邮件）。
# 只有当 ENVIRONMENT=development **且** 该项显式为 "true" 时才生效，两个条件缺一不可。
# 生产环境必须保持 false 或不设置——否则任何人都能拿任意邮箱登录。
ALLOW_DEV_CODE=false

# ---- 百度网盘 OAuth（仅在启用百度网盘云同步时需要）----

# 【可选·普通配置】百度网盘开放平台 AppKey（即 OAuth 的 client_id）。
# AppKey 是公开标识，放 vars 里没问题；真正敏感的是下面的 AppSecret。
BAIDU_APP_KEY=

# 【必填·密钥·启用百度同步时】百度网盘的 AppSecret（SecretKey）。
# 这个值**绝不能进客户端**，也不能进仓库或 wrangler.toml，只能通过 secret 注入。
# 授权流程由服务端中转：客户端拿不到 AppSecret，也拿不到长期 token。
BAIDU_APP_SECRET=

# 【可选·普通配置】百度 OAuth 的回调地址，必须与开放平台后台登记的完全一致。
# 示例：https://qmai.pro/oauth/baidu/callback
BAIDU_REDIRECT_URI=

# 【可选·普通配置】百度授权模式：dir（网盘目录）。
BAIDU_AUTH_MODE=dir


# ============================================================================
# analytics-worker —— 匿名使用统计
# ============================================================================
# 部署目录：analytics-worker/
# 路由：analytics.qmai.pro（上报）、qmai.pro/qmai-ops*（后台）

# 【必填·密钥】后台入口的真实路径，形如 /qmai-ops-xxxxxxxx（xxxxxxxx 是随机串）。
# 仓库里只保留通用前缀 /qmai-ops*，真实路径只存在于这个 secret 里。
# 未设置时后台整体返回 404——不知道路径就等于没有后台入口。
ADMIN_PATH=

# 【必填·密钥】后台登录密码。首次进入后台时用它初始化管理员凭据。
DASHBOARD_PASSWORD=

# 【必填·密钥】统计接口的校验密钥，防止有人刷统计数据。
STATS_SECRET=

# 【可选·普通配置】公告内容。不填则客户端不显示公告。
ANNOUNCEMENTS=


# ============================================================================
# 客户端构建期变量（可选，一般不需要改）
# ============================================================================
# 说明：客户端默认连接生产环境地址；本地联调时可覆盖。

# 【可选】账号服务地址，默认 https://account.qmai.pro
# VITE_ACCOUNT_BASE_URL=

# 【可选】内置模型中转站地址，默认 https://relay.qmai.work
# VITE_RELAY_BASE_URL=
