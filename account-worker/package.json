{
  "name": "qmai-account-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "青幕AI写作账号服务：邮箱验证码注册、密码登录、JWT + 轮换 refresh",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node test/smoke.mjs",
    "db:create": "wrangler d1 create qmai-account-db",
    "db:migrate": "wrangler d1 execute qmai-account-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute qmai-account-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
