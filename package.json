{
  "name": "qmai",
  "private": true,
  "version": "4.4.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --build --pretty",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run test:mocks && npm run test:llm",
    "test:mocks": "node scripts/lint-character-aura.mjs && vitest run --exclude='**/*.real-llm.test.ts' --exclude='**/.worktrees/**' --exclude='**/.claude/**' --exclude='**/.codex-temp/**' --exclude='**/superpowers-main/**' --exclude='**/SKILL/**' --exclude='**/superpowers/**' --exclude='**/account-worker/**' --exclude='**/nul'",
    "lint:character-aura": "node scripts/lint-character-aura.mjs",
    "test:llm": "vitest run real-llm --no-file-parallelism --reporter=verbose --exclude='**/.claude/**' --exclude='**/.worktrees/**' --exclude='**/.codex-temp/**'",
    "tauri": "tauri",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"npx.cmd tauri build --no-bundle; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/build-portable.mjs\"",
    "build:github-release": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (-not $env:TAURI_SIGNING_PRIVATE_KEY_PATH) { $env:TAURI_SIGNING_PRIVATE_KEY_PATH = Join-Path $env:USERPROFILE '.tauri\\qmai-updater.key' }; if (-not (Test-Path $env:TAURI_SIGNING_PRIVATE_KEY_PATH)) { throw '缺少 TAURI_SIGNING_PRIVATE_KEY_PATH 对应的签名私钥文件' }; if ($null -eq $env:TAURI_SIGNING_PRIVATE_KEY_PASSWORD) { $env:TAURI_SIGNING_PRIVATE_KEY_PASSWORD = '' }; npx tauri build; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/build-portable.mjs; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; node scripts/prepare-github-release.mjs\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@milkdown/kit": "^7.23.0",
    "@milkdown/react": "^7.23.0",
    "@milkdown/theme-nord": "^7.23.0",
    "@react-sigma/core": "^5.0.6",
    "@sentry/react": "^10.78.0",
    "@sigma/edge-curve": "^3.1.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "i18next": "^26.7.1",
    "js-yaml": "^4.3.2",
    "jsonrepair": "^3.15.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.67.0",
    "macos-traffic-lights": "^1.1.0",
    "mermaid": "^11.17.2",
    "opencc-js": "^1.4.2",
    "pangu": "^10.4.1",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.18.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sigma": "^3.0.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.10.2",
    "iconv-lite": "^0.7.3",
    "jsdom": "^29.1.1",
    "shadcn": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "source-map-js": "^1.2.2"
  }
}
